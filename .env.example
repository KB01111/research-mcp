# ---- Firecrawl (your fork) ----
# Point this at your self-hosted fork. Default is the official Firecrawl API shape.
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# ---- Tavily (primary fallback scraper/search) ----
TAVILY_API_KEY=

# ---- Jina Reader (no-key fallback for scraping) ----
JINA_API_KEY=

# ---- LLM (free tier defaults) ----
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---- Rerankers (free tier) ----
COHERE_API_KEY=
JINA_API_KEY=

# ---- X / Twitter (no free public API — opt-in) ----
TWITTERAPI_IO_KEY=

# ---- Google SERP (no free public API — opt-in) ----
SERPER_API_KEY=
SERPAPI_API_KEY=

# ---- Defaults ----
DEFAULT_SOURCES=firecrawl,github,arxiv,ossinsight,devto,tavily
SUMMARIZER_MODEL=groq          # groq | gemini | openrouter
RERANKER_MODEL=cohere          # cohere | jina | local
SCRAPER_METHOD=firecrawl       # firecrawl | tavily | jina
MAX_RESULTS_PER_SOURCE=10
MAX_CONCURRENT_SCRAPES=10
